# Copy this file to Dockerfile in the paper's standalone repository.
# Build context: that repository, containing experiment.yml, paper/, and requirements.lock.
# Pin PYTHON_IMAGE to a digest for a repeatable deployment; keep the same architecture.
ARG PYTHON_IMAGE=python:3.12-slim-bookworm

FROM ${PYTHON_IMAGE} AS wheel_builder
ARG EWS_REV
RUN apt-get update \
    && apt-get install --yes --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.lock /tmp/requirements.lock
# The lock includes runtime dependencies and the setuptools/wheel build dependencies.
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock
RUN python -c 'import re, sys; assert re.fullmatch(r"[0-9a-f]{40}", sys.argv[1]), "EWS_REV must be a full Git commit hash"' "${EWS_REV}" \
    && python -m pip wheel --no-cache-dir --no-deps --no-build-isolation \
        --wheel-dir /wheels \
        "experiments-wo-stress @ git+https://github.com/m1gwings/experiments-wo-stress.git@${EWS_REV}"

FROM ${PYTHON_IMAGE} AS runtime
ARG EWS_REV
ARG STUDY_REV=unrecorded
LABEL org.opencontainers.image.revision="${STUDY_REV}" \
      org.experiments-wo-stress.library-revision="${EWS_REV}"
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MPLCONFIGDIR=/tmp/matplotlib \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1
WORKDIR /workspace
COPY requirements.lock /tmp/requirements.lock
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock
COPY --from=wheel_builder /wheels /wheels
RUN python -m pip install --no-cache-dir --no-deps /wheels/experiments_wo_stress-*.whl \
    && python -m pip check \
    && rm -rf /wheels /tmp/requirements.lock
COPY . /workspace
STOPSIGNAL SIGTERM
ENTRYPOINT ["ews"]
CMD ["--help"]
